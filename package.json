{
  "name": "typing-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "allowScripts": {
    "argon2": true
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:server": "npm run dev --workspace @typing/server",
    "dev:web": "npm run dev --workspace @typing/web",
    "start": "npm run start --workspace @typing/server",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "npm run test --workspace @typing/server"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
