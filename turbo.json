{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "MONGO_URI",
    "REDIS_URL",
    "PORT",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "ACCESS_TOKEN_TTL",
    "REFRESH_TOKEN_DAYS",
    "FRONTEND_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_SOCKET_URL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
